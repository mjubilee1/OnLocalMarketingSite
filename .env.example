# Copy to .env.local and fill in. Server-side only — never prefix with VITE_.
OPENROUTER_API_KEY=
# Optional: override the free-model fallback order (comma-separated OpenRouter model ids)
# OPENROUTER_MODELS=nex-agi/nex-n2.5-mini:free,nvidia/nemotron-3-super-120b-a12b:free

# --- Email for crew invites & reminders (pick ONE provider) ---
# The From address must be on a domain you've verified with the provider.
EMAIL_FROM="Your Company <crew@yourdomain.com>"

# Option A: Resend (https://resend.com)
# RESEND_API_KEY=re_...

# Option B: SMTP, e.g. Google Workspace (use an App Password), Microsoft 365, SendGrid SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=crew@yourdomain.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false

# --- Course cover photos (optional) ---
# AI picks search terms from each course, then photos come from a library licensed for commercial use.
# Without a key, Openverse (Creative Commons) is used. A free Pexels key gives far better matches.
# Pexels: https://www.pexels.com/api/
# PEXELS_API_KEY=
# Unsplash: https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=
